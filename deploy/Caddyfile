{
	email {$ACME_EMAIL}
	# Compose mounts the mail certificate from this issuer's storage directory.
	cert_issuer acme https://acme-v02.api.letsencrypt.org/directory
}

bond-sdc.com {
	# Admin is served by Digest Bot under the landing site's hostname.
	@admin path /admin /admin/*
	handle @admin {
		request_body {
			max_size 8KiB
		}
		reverse_proxy digest-bot:8080 {
			header_up X-Sdc-Admin-Client {remote_host}
		}
	}
	handle {
		root * /usr/share/caddy
		file_server
	}
}

www.bond-sdc.com {
	redir https://bond-sdc.com{uri} permanent
}

digest.bond-sdc.com {
	# Keep admin routes on the dedicated origin above.
	@admin path /admin /admin/*
	respond @admin 404
	request_body {
		max_size 16KiB
	}
	header {
		X-Frame-Options SAMEORIGIN
		Referrer-Policy same-origin
	}
	reverse_proxy digest-bot:8080 {
		header_up -Authorization
	}
}

(no_mail_delivery) {
}

import {$DIGEST_MAIL_CONFIG:no_mail_delivery}
