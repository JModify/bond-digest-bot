# Provide the certificate account's contact email before starting Compose.
ACME_EMAIL=
# Use other for web only. Server also needs compose.delivery.yaml.
DIGEST_PROCESSING_METHOD=other
# Shown on the Automatic tab with either processing method.
DIGEST_GROUP_ADDRESS=sdc@groups.bond.edu.au
# Enable the private admin panel. Provision the owner via the EC2 terminal.
SDC_ADMIN_ENABLED=false
# Optional. The instance role also needs ec2:RebootInstances for this specific instance.
SDC_ADMIN_EC2_INSTANCE_ID=
